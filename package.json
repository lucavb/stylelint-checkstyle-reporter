{
    "name": "stylelint-checkstyle-reporter",
    "version": "1.1.2",
    "description": "Output Checkstyle XML reports of stylelint results",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/stylelint-checkstyle-reporter.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/stylelint-checkstyle-reporter.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts",
    "bin": {
        "stylelint-checkstyle-reporter": "dist/reporter-with-stdin.mjs"
    },
    "scripts": {
        "build": "rollup -c && npm run make-executable",
        "format": "prettier -w --ignore-unknown .",
        "lint:attw": "attw --pack .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:eslint": "eslint .",
        "lint:prettier:fix": "prettier \"**/*\" --write --ignore-unknown",
        "lint:prettier": "prettier \"**/*\" --check --ignore-unknown",
        "lint:typecheck:watch": "tsc -p tsconfig.app.json --noEmit --watch",
        "lint:typecheck": "tsc -p tsconfig.app.json --noEmit",
        "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:typecheck",
        "make-executable": "./scripts/make-node-executable.sh ./dist/reporter-with-stdin.mjs",
        "prepack": "npm run build",
        "semantic-release": "semantic-release",
        "test:watch": "vitest",
        "test": "vitest run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lucavb/stylelint-checkstyle-reporter.git"
    },
    "keywords": [
        "stylelint",
        "checkstyle",
        "formatter",
        "reporter",
        "report"
    ],
    "author": {
        "name": "Luca Becker",
        "email": "luca.becker@sunbury.xyz",
        "url": "https://sunbury.xyz"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.12"
    },
    "files": [
        "dist",
        "index.js"
    ],
    "bugs": {
        "url": "https://github.com/lucavb/stylelint-checkstyle-reporter/issues"
    },
    "homepage": "https://github.com/lucavb/stylelint-checkstyle-reporter#readme",
    "publishConfig": {
        "provenance": true
    },
    "dependencies": {
        "get-stdin": "9.0.0",
        "xmlbuilder2": "4.0.3"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@eslint/js": "9.39.5",
        "@rollup/plugin-terser": "1.0.2",
        "@rollup/plugin-typescript": "12.3.1",
        "@types/node": "26.6.7",
        "eslint": "9.39.5",
        "jiti": "2.7.0",
        "prettier": "3.10.1",
        "rollup": "4.68.8",
        "rxjs": "7.8.2",
        "semantic-release": "26.0.1",
        "stylelint": "18.1.0",
        "stylelint-config-recommended-scss": "16.0.2",
        "stylelint-config-standard": "39.0.1",
        "stylelint-scss": "7.5.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.74.0",
        "vitest": "5.1.1"
    }
}
